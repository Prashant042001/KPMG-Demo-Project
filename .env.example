# Front end: URL of the local FastAPI backend. Copy to .env.local to override the default.
VITE_API_BASE_URL=http://localhost:8000

# GIS map background tiles. Only the visible map area is requested (no site or payment data is sent).
# Point these at a company-approved tile server if public OpenStreetMap tiles are not allowed.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
