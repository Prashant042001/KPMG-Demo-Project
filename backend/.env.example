# Copy to backend/.env and adjust. All settings are optional; defaults are shown.

# Browser origins allowed to call the API (the Vite dev server).
NCA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
NCA_MAX_FILE_SIZE_MB=200
NCA_MAX_SUPPORTING_FILES=10

# Completed jobs and their outputs are discarded from memory after this many minutes.
NCA_JOB_TTL_MINUTES=60
NCA_MAX_JOBS_IN_MEMORY=20
NCA_WORKER_THREADS=2

# Authoritative, version-controlled rule configuration (approved rules, aliases, formats, patterns, priorities).
# NCA_RULE_CONFIG_PATH=config/rule_config.json

NCA_LOG_LEVEL=INFO
